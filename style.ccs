/* Variáveis de cores baseadas no tema Dark/Light do GitHub */
:root {
    --gh-bg: #0d1117;
    --gh-header-bg: #161b22;
    --gh-border: #30363d;
    --gh-text: #c9d1d9;
    --gh-text-muted: #8b949e;
    --gh-link: #58a6ff;
    --gh-success: #238636;
    --gh-success-hover: #2ea44f;
    --gh-card-bg: #161b22;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--gh-bg);
    color: var(--gh-text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
}

/* Header */
.gh-header {
    background-color: var(--gh-header-bg);
    padding: 16px 32px;
    border-bottom: 1px solid var(--gh-border);
}

.gh-nav-container {
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    gap: 12px;
}

.mega-octicon {
    font-size: 32px;
    fill: currentColor;
}

.gh-breadcrumb {
    font-size: 20px;
    display: flex;
    gap: 6px;
}

.gh-breadcrumb a {
    color: var(--gh-link);
    text-decoration: none;
}

.gh-breadcrumb .repo-name {
    font-weight: 600;
}

.separator {
    color: var(--gh-text-muted);
}

.badge-public {
    border: 1px solid var(--gh-border);
    border-radius: 2em;
    padding: 0 8px;
    font-size: 12px;
    color: var(--gh-text-muted);
    font-weight: 500;
}

/* Container & Tabs */
.gh-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 16px;
}

.gh-tabs {
    display: flex;
    border-bottom: 1px solid var(--gh-border);
    margin-bottom: 24px;
    gap: 8px;
}

.tab {
    padding: 8px 16px;
    cursor: pointer;
    color: var(--gh-text);
    border-bottom: 2px solid transparent;
    display: flex;
    align-items: center;
    gap: 6px;
}

.tab.active {
    border-bottom-color: #f78166;
    font-weight: 600;
}

.counter {
    background-color: #30363d;
    padding: 2px 6px;
    border-radius: 20px;
    font-size: 12px;
}

/* Layout */
.gh-content-layout {
    display: flex;
    gap: 24px;
}

.main-content {
    flex: 2;
}

.sidebar {
    flex: 1;
}

/* Cards / Boxes */
.box-card {
    background-color: var(--gh-card-bg);
    border: 1px solid var(--gh-border);
    border-radius: 6px;
    overflow: hidden;
}

.box-header {
    background-color: #1f242c;
    padding: 12px 16px;
    border-bottom: 1px solid var(--gh-border);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
}

.box-body {
    padding: 16px;
}

/* Form */
.input-group {
    margin-bottom: 16px;
}

.input-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 500;
}

.input-wrapper {
    display: flex;
    position: relative;
}

.input-wrapper input {
    width: 100%;
    background-color: var(--gh-bg);
    border: 1px solid var(--gh-border);
    border-radius: 6px;
    color: var(--gh-text);
    padding: 6px 40px 6px 12px;
    font-size: 14px;
}

.input-wrapper input:focus {
    outline: none;
    border-color: var(--gh-link);
    box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.3);
}

.unit {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gh-text-muted);
    font-size: 12px;
}

.btn-gh-primary {
    background-color: var(--gh-success);
    color: #ffffff;
    border: 1px solid rgba(240,246,252,0.1);
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    width: 100%;
}

.btn-gh-primary:hover {
    background-color: var(--gh-success-hover);
}

/* Results */
.results-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.result-line {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid rgba(48, 54, 61, 0.5);
}

.result-label {
    font-weight: 500;
}

.result-value {
    font-family: monospace;
    color: #58a6ff;
    font-size: 15px;
    font-weight: bold;
}

.sidebar-info h4 {
    margin: 12px 0 6px 0;
}

.sidebar-info ul {
    list-style-type: none;
    padding-left: 0;
}

.sidebar-info li {
    font-family: monospace;
    background: #0d1117;
    padding: 4px 8px;
    margin-bottom: 4px;
    border-radius: 4px;
}

.mt-20 { margin-top: 20px; }

/* Rodapé */
.gh-footer {
    border-top: 1px solid var(--gh-border);
    margin-top: 40px;
    padding: 40px 16px;
    font-size: 12px;
    color: var(--gh-text-muted);
}

.footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
}

.footer-left {
    display: flex;
    align-items: center;
    gap: 8px;
}

.footer-logo {
    font-size: 20px;
}

.footer-links {
    display: flex;
    list-style: none;
    gap: 16px;
}

.footer-links a {
    color: var(--gh-link);
    text-decoration: none;
}

.footer-links a:hover {
    text-decoration: underline;
}

@media (max-width: 768px) {
    .gh-content-layout {
        flex-direction: column;
    }
}

