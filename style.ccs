:root{
  --bg:#f6f8fa;
  --card:#ffffff;
  --muted:#6a737d;
  --accent:#24292f;
  --primary:#0366d6;
  --success:#28a745;
  --danger:#d73a49;
  --glass: rgba(0,0,0,0.04);
  --radius:8px;
  --mono: "Segoe UI Mono", "SFMono-Regular", Menlo, Monaco, monospace;
  --ui-sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  font-family:var(--ui-sans);
  background:var(--bg);
  color:#24292f;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  line-height:1.4;
}

.container{
  max-width:980px;
  margin:0 auto;
  padding:1rem;
}

/* Header */
.site-header{
  background:linear-gradient(180deg,#24292f,#0b0c0d);
  color:#fff;
  padding:0.6rem 0;
  box-shadow:0 1px 0 rgba(0,0,0,0.06);
}
.header-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.brand{display:flex;align-items:center;gap:0.6rem}
.brand h1{font-size:1rem;margin:0;font-weight:600}
.logo{opacity:0.95}

.nav{font-size:0.9rem;color:#9aa3ad}

/* Main card */
.main-card{
  margin-top:1.25rem;
  display:block;
}
.main-card .intro{margin-bottom:0.8rem}
.main-card .calculator{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap:1rem;
  align-items:start;
}

.inputs, .results{
  background:var(--card);
  border-radius:var(--radius);
  padding:1rem;
  box-shadow:0 1px 3px rgba(27,31,35,0.04);
}

.inputs label{
  display:block;
  margin-bottom:0.6rem;
  font-size:0.95rem;
  color:var(--muted);
}
.inputs input{
  width:100%;
  padding:0.5rem 0.6rem;
  margin-top:0.25rem;
  border:1px solid #d0d7de;
  border-radius:6px;
  font-size:1rem;
  background:linear-gradient(180deg, #fff, #fbfbfb);
}

.buttons{
  margin-top:0.6rem;
  display:flex;
  gap:0.6rem;
  align-items:center;
}
button{
  background:var(--primary);
  color:#fff;
  border:none;
  padding:0.55rem 0.9rem;
  border-radius:6px;
  cursor:pointer;
  font-weight:600;
}
button.ghost{
  background:transparent;
  color:var(--primary);
  border:1px solid rgba(3,102,214,0.15);
}

.error{color:var(--danger);margin-top:0.5rem}

/* Results */
.results h3{margin-top:0;margin-bottom:0.6rem}
.results ul{list-style:none;padding:0;margin:0}
.results li{padding:0.35rem 0;border-bottom:1px dashed #f1f4f6}
.results li strong{float:right;color:var(--accent)}
.note{font-size:0.85rem;color:var(--muted);margin-top:0.8rem}

/* Footer */
.site-footer{
  margin-top:1.6rem;
  padding:1rem 0;
  color:var(--muted);
  font-size:0.9rem;
  border-top:1px solid rgba(27,31,35,0.06);
  background:transparent;
}
.footer-inner{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.small{opacity:0.8;font-size:0.82rem}

/* Responsive */
@media (max-width:800px){
  .main-card .calculator{grid-template-columns:1fr}
  .results li strong{float:none;display:block;margin-top:0.25rem}
}
